{
  "name": "endur-video-generator",
  "version": "1.0.0",
  "description": "Remotion project that renders Endur training PPTX slides into MP4 videos",
  "scripts": {
    "preview": "npx remotion preview src/index.ts",
    "extract": "bash scripts/extract-slides.sh",
    "render": "bash scripts/render-all.sh",
    "render:module": "npx remotion render src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
